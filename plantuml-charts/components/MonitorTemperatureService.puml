@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

Container(frontend, "Веб-интерфейс")

Boundary(server, "Server") {
    Boundary(monitorTemperatureService, "Сервис для мониторинга температур", "Java") {
        Component(controller, "Controller", "Spring Controller", "Kafka consumer. Подписывается на соответствующий Kafka топик и читает все команды (узнать температуру) и прокидывает команды дальше")
        Component(command, "Command component", "Spring Bean", "Обрабатывает все команды от контроллера, проверяет их валидность, если все ок, то исполняет команду (забирает через Kafka из БД температуру)")
        Component(job, "Job component", "Spring Bean", "Раз в Х время опрашивает датчики отопления через Kafka и пишет в Kafka с последующей записью в БД, тем самым в БД всегда будут актуальные данные по температуре и их можно будет забрать без ожидания")
    }

    Container(apiGateway, "Api-gateway", "Kong")
    ContainerDb(db, "Database", "PostgreSQL")
    ContainerDb(kafka, "Kafka", "Kafka")
}

Boundary(sensors, "Sensors") {
    System(sensor1, "Устройства отопления")
}

Rel(frontend, apiGateway, "Requests", "HTTPS")
Rel(apiGateway, kafka, "Write")
Rel(controller, kafka, "Read")
Rel(controller, command, "Uses")
Rel(command, kafka, "Uses")
Rel(job, kafka, "Uses")
BiRel(sensor1, kafka, "Send data", "HTTPS")

Rel(kafka, db, "Read/Write")
@enduml