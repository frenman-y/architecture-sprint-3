@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

Container(frontend, "Веб-интерфейс")

Boundary(server, "Server") {
    Boundary(streamingService, "Сервис для наблюдения за домом", "Java") {
        Component(controller, "Controller", "Spring Controller", "Kafka consumer. Подписывается на соответствующий Kafka топик и читает все команды (например: сообщение о необходимости подключения к камере) и прокидывает команды дальше")
        Component(command, "Command component", "Spring Bean", "Обрабатывает все команды от контроллера, проверяет их валидность, если все ок, то осуществляет подключение для передачи видео пользователю")
    }

    Container(apiGateway, "Api-gateway", "Kong")
    ContainerDb(devicesDb, "Devices DB", "PostgreSQL")
}

Boundary(devices, "Devices") {
    System(device1, "Устройства камер")
}

Rel(frontend, apiGateway, "Requests", "HTTPS")
Rel(apiGateway, controller, "Uses")
Rel(controller, command, "Uses")
BiRel(command, device1, "Uses", "Telemetry")
Rel(command, devicesDb, "Read/Write", "SQL")
@enduml